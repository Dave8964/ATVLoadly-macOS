index 0000000..0f770aa
--- /dev/null
+++ b/internal/nativeupdate/control_test.go
@@ -0,0 +1,86 @@
+package nativeupdate
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+)
+
+func TestGatePreventsUpdateDuringWork(t *testing.T) {
+	var g Gate
+	release, err := g.Enter()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !errors.Is(g.Quiesce(nil), ErrBusy) {
+		t.Fatal("update allowed during installation")
+	}
+	release()
+	release()
+	if !errors.Is(g.Quiesce(func() bool { return true }), ErrBusy) {
+		t.Fatal("queued install ignored")
+	}
+	if err = g.Quiesce(nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = g.Enter(); !errors.Is(err, ErrMaintenance) {
+		t.Fatal("installation started during update")
+	}
+	g.Resume()
+	release, err = g.Enter()
+	if err != nil {
+		t.Fatal(err)
+	}
+	release()
+}
+func TestGateConcurrentSessions(t *testing.T) {
+	var g Gate
+	var wg sync.WaitGroup
+	for range 32 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			release, err := g.Enter()
+			if err == nil {
+				release()
+			}
+		}()
+	}
+	wg.Wait()
+	if err := g.Quiesce(nil); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestProbationRequiresAuthenticatedCommit(t *testing.T) {
+	root := t.TempDir()
+	marker := filepath.Join(root, "pending.json")
+	if err := os.WriteFile(marker, []byte("{}"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("ATVLOADLY_UPDATE_JOURNAL", marker)
+	oldToken, oldProbation, oldStart := token, probation, startJobs
+	defer func() { Operations = Gate{}; token = oldToken; probation = oldProbation; startJobs = oldStart }()
+	Operations = Gate{}
+	calls := 0
+	if err := Initialize(root, func() error { calls++; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if !Probation() || Authorized("wrong") || !Authorized(token) {
+		t.Fatal("probation/control authentication failed")
+	}
+	if _, err := Operations.Enter(); !errors.Is(err, ErrMaintenance) {
+		t.Fatal("install allowed during probation")
+	}
+	if err := Commit(); err != nil {
+		t.Fatal(err)
+	}
+	if err := Commit(); err != nil {
+		t.Fatal(err)
+	}
+	if Probation() || calls != 1 {
+		t.Fatal("commit did not start jobs exactly once")
+	}
+}
diff --git a/internal/nativeupdate/control.go b/internal/nativeupdate/control.go
new file mode 100644
index 0000000..c34119a
--- /dev/null
+++ b/internal/nativeupdate/control.go
@@ -0,0 +1,106 @@
+// Package nativeupdate coordinates native application updates with installation work.
+package nativeupdate
+
+import (
+	"crypto/rand"
+	"crypto/subtle"
+	"encoding/hex"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+)
+
+var ErrBusy = errors.New("an installation or installation session is active")
+var ErrMaintenance = errors.New("application update in progress")
+
+type Gate struct {
+	mu          sync.Mutex
+	active      int
+	maintenance bool
+}
+
+func (g *Gate) Enter() (func(), error) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.maintenance {
+		return nil, ErrMaintenance
+	}
+	g.active++
+	var once sync.Once
+	return func() { once.Do(func() { g.mu.Lock(); g.active--; g.mu.Unlock() }) }, nil
+}
+func (g *Gate) Quiesce(pending func() bool) error {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.active > 0 || (pending != nil && pending()) {
+		return ErrBusy
+	}
+	g.maintenance = true
+	return nil
+}
+func (g *Gate) Resume() { g.mu.Lock(); g.maintenance = false; g.mu.Unlock() }
+
+var Operations Gate
+var token string
+var probation bool
+var startJobs func() error
+var commitMu sync.Mutex
+
+func Initialize(dataDir string, start func() error) error {
+	path := filepath.Join(dataDir, ".native-control-token")
+	b, err := os.ReadFile(path)
+	if os.IsNotExist(err) {
+		random := make([]byte, 32)
+		if _, err = rand.Read(random); err != nil {
+			return err
+		}
+		b = []byte(hex.EncodeToString(random))
+		if err = os.WriteFile(path, b, 0600); err != nil {
+			return err
+		}
+	} else if err != nil {
+		return err
+	}
+	if len(strings.TrimSpace(string(b))) != 64 {
+		return errors.New("invalid native control token")
+	}
+	if err = os.Chmod(path, 0600); err != nil {
+		return err
+	}
+	token = strings.TrimSpace(string(b))
+	startJobs = start
+	if path := os.Getenv("ATVLOADLY_UPDATE_JOURNAL"); path != "" {
+		if _, err := os.Stat(path); err == nil {
+			probation = true
+			return Operations.Quiesce(nil)
+		} else if !os.IsNotExist(err) {
+			return err
+		}
+	}
+	return nil
+}
+func Authorized(candidate string) bool {
+	return token != "" && subtle.ConstantTimeCompare([]byte(candidate), []byte(token)) == 1
+}
+func Probation() bool { commitMu.Lock(); defer commitMu.Unlock(); return probation }
+func Commit() error {
+	commitMu.Lock()
+	defer commitMu.Unlock()
+	if !probation {
+		return nil
+	}
+	if startJobs == nil {
+		return errors.New("service not initialized")
+	}
+	Operations.Resume()
+	if err := startJobs(); err != nil {
+		_ = Operations.Quiesce(nil)
+		return err
+	}
+	probation = false
+	return nil
+}
+
+func Recover() error { return recoverWatchdog(os.Getenv("ATVLOADLY_UPDATE_JOURNAL")) }

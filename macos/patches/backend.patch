@@ -0,0 +1,41 @@
+package app
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestAtomicSettingsFlushKeepsScheduleAndPrivatePermissions(t *testing.T) {
+	old := Settings
+	defer func() { Settings = old }()
+	Settings = &SettingsConfiguration{}
+	Settings.Task.Enabled = true
+	Settings.Task.CrodTime = "0 4 * * *"
+	path := filepath.Join(t.TempDir(), "settings.json")
+	if err := flushSettingsTo(path); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm() != 0600 {
+		t.Fatal("settings permissions are not private")
+	}
+	var saved SettingsConfiguration
+	b, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = json.Unmarshal(b, &saved); err != nil {
+		t.Fatal(err)
+	}
+	if !saved.Task.Enabled || saved.Task.CrodTime != Settings.Task.CrodTime {
+		t.Fatal("schedule lost during flush")
+	}
+	if _, err = os.Stat(path + ".tmp"); !os.IsNotExist(err) {
+		t.Fatal("temporary settings file was not committed")
+	}
+}

+func networkFingerprint() string {
+	interfaces, err := net.Interfaces()
+	if err != nil {
+		return "unavailable"
+	}
+	var entries []string
+	for _, iface := range interfaces {
+		if iface.Flags&net.FlagUp == 0 || iface.Flags&net.FlagMulticast == 0 || iface.Flags&net.FlagLoopback != 0 {
+			continue
+		}
+		addresses, err := iface.Addrs()
+		if err != nil {
+			continue
+		}
+		for _, address := range addresses {
+			prefix, err := netip.ParsePrefix(address.String())
+			if err == nil && isLanAddr(prefix.Addr()) {
+				entries = append(entries, iface.Name+":"+address.String())
+			}
+		}
+	}
+	sort.Strings(entries)
+	return strings.Join(entries, ";")
+}
+
+func discoveryNeedsRestart(previous, current string, last, currentTime time.Time) bool {
+	return previous != current || currentTime.UnixNano()-last.UnixNano() > int64(45*time.Second)
+}

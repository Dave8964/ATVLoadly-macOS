@@ -0,0 +1,31 @@
+//go:build darwin
+
+package nativeupdate
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"syscall"
+)
+
+func recoverWatchdog(path string) error {
+	executable := filepath.Join(filepath.Dir(path), "watchdog")
+	if _, err := os.Stat(executable); err != nil {
+		return err
+	}
+	log, err := os.OpenFile(filepath.Join(filepath.Dir(path), "watchdog.log"), os.O_WRONLY|os.O_CREATE|os.O_APPEND, 0600)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = log.Close() }()
+	cmd := exec.Command(executable, "watch", path)
+	cmd.Stdout = log
+	cmd.Stderr = log
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setsid: true}
+	if err := cmd.Start(); err != nil {
+		return err
+	}
+	_ = cmd.Process.Release()
+	return nil
+}

@@ -0,0 +1,36 @@
+package task
+
+import (
+	"context"
+	"errors"
+	"github.com/bitxeno/atvloadly/internal/model"
+	"github.com/bitxeno/atvloadly/internal/signing"
+	"testing"
+)
+
+func TestAppleTVReconnectRetriesRefresh(t *testing.T) {
+	tv := model.Device{DeviceClass: "AppleTV"}
+	phone := model.Device{DeviceClass: "iPhone"}
+	if !shouldRefreshOnConnect(tv, true, false) {
+		t.Fatal("Apple TV incorrectly gated by iPhone refresh preference")
+	}
+	if shouldRefreshOnConnect(tv, false, true) {
+		t.Fatal("disabled refresh started")
+	}
+	if shouldRefreshOnConnect(phone, true, false) {
+		t.Fatal("disabled iPhone refresh started")
+	}
+	if !shouldRefreshOnConnect(phone, true, true) {
+		t.Fatal("enabled iPhone refresh did not start")
+	}
+}
+func TestUnreachableTVDoesNotBlacklistIPABuild(t *testing.T) {
+	for _, err := range []error{signing.Errorf(signing.ClassTransport, signing.CodeDeviceUnreachable, "device asleep"), context.DeadlineExceeded} {
+		if failedSourceBuildID("nuvio-release", err) != "" {
+			t.Fatal("temporary transport failure permanently blacklisted update")
+		}
+	}
+	if failedSourceBuildID("bad-build", errors.New("invalid IPA")) != "bad-build" {
+		t.Fatal("invalid IPA lost its failure guard")
+	}
+}
diff --git a/internal/manager/device_manager_mdns_macos_test.go b/internal/manager/device_manager_mdns_macos_test.go

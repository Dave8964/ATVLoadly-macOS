+	dm.pairingCheckedAt = make(map[string]time.Time)
+	dm.remotePairingServices = make(map[string]string)
+	dm.pairingMu.Unlock()
+	dm.devices.Range(func(k, v any) bool { dm.devices.Delete(k); return true })
+}

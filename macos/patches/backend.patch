diff --git a/internal/manager/device_manager_mdns_macos_test.go b/internal/manager/device_manager_mdns_macos_test.go
new file mode 100644
index 0000000..c051837
--- /dev/null
+++ b/internal/manager/device_manager_mdns_macos_test.go
@@ -0,0 +1,42 @@
+//go:build !linux
+
+package manager
+
+import (
+	"net/netip"
+	"testing"
+
+	"github.com/betamos/zeroconf"
+	"github.com/bitxeno/atvloadly/internal/model"
+)
+
+func TestMDNSUpdatedAddress(t *testing.T) {
+	dm := newDeviceManager()
+	service := "paired-tv"
+	dm.devices.Store("udid", model.Device{UDID: "udid", ServiceName: service, Connection: model.DeviceConnectionRemote, IP: "192.168.1.2"})
+	dm.checkPairingThrottle("identifier")
+	dm.handleMDNSEvent(zeroconf.Event{Op: zeroconf.OpUpdated, Service: &zeroconf.Service{
+		Name: service, Type: zeroconf.NewType(mdnsServiceRemotePairing), Port: 1234,
+		Addrs: []netip.Addr{netip.MustParseAddr("192.168.1.9")}, Text: []string{"identifier=identifier", "authTag=private"},
+	}})
+	value, ok := dm.devices.Load("udid")
+	if !ok {
+		t.Fatal("paired device disappeared")
+	}
+	dev := value.(model.Device)
+	if dev.IP != "192.168.1.9" || dev.Port != 1234 {
+		t.Fatalf("stale connection: %s:%d", dev.IP, dev.Port)
+	}
+}
+
+func TestFirstAddrPrivateIPv4(t *testing.T) {
+	got, ok := firstAddrString([]netip.Addr{netip.MustParseAddr("2001:db8::1"), netip.MustParseAddr("8.8.8.8"), netip.MustParseAddr("192.168.1.22")})
+	if !ok || got != "192.168.1.22" {
+		t.Fatalf("unexpected address %q %v", got, ok)
+	}
+	if _, ok := firstAddrString([]netip.Addr{netip.MustParseAddr("8.8.8.8")}); ok {
+		t.Fatal("public address accepted")
+	}
+}
+
+func TestMDNSNilService(t *testing.T) { newDeviceManager().handleMDNSEvent(zeroconf.Event{}) }
